# ─── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ──────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/sholex

# ─── URLs ──────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Auth & Security ───────────────────────────────────
JWT_SECRET=your_super_secret_jwt_secret_here

# ─── Payment (Paystack) ────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx

# ─── Cloudinary ────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Bank Transfer Details (Optional) ─────────────────
BANK_ACCOUNT_NUMBER=0123456789
BANK_ACCOUNT_NAME=Your Account Name
BANK_NAME=Your Bank Name

# ─── WhatsApp Contact (Optional) ──────────────────────
WHATSAPP_NUMBER=+2348000000000

# ─── Email (Brevo) ────────────────────────────────────
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Sholex
ADMIN_EMAIL=admin@yourdomain.com

# ─── Marketing Email (Brevo) ──────────────────────────
MARKETING_SENDER_EMAIL=marketing@yourdomain.com
MARKETING_SENDER_NAME=Sholex

ABANDONED_CART_CRON_SECRET=your-secret-key

# ─── Web Push (VAPID) ────────────────────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key